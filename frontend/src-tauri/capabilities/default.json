{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for LLMChat",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/llmchat-backend",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/llmchat-backend",
          "sidecar": true
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
