[General]
apiUrl=https://api.deepseek.com/v1/chat/completions
apiKey=your-api-key-here
model=deepseek-chat
messagePageSize=30
port=17800
proxyMode=direct
httpProxy=
translateProvider=bing
translateSource=en
translateTarget=zh-CN
translateMaxLength=0
translateAutoChunk=true
ocrLang=eng
ocrAutoTranslate=true
ocrTranslateProvider=bing
ocrTranslateSource=en
ocrTranslateTarget=zh-CN
ocrTranslateMaxLength=0
ocrTranslateAutoChunk=true
textTranslateSource=en
textTranslateTarget=zh-CN
textTranslateProvider=llm
textTranslatePrompt=You are a precise bilingual translator. Translate the user text faithfully. Output only the translation with no quotes, notes, or explanations.
textGlossary=[]
textPreReplace=[]
textPostReplace=[]
# Empty = <software-dir>/text-projects ; each project is a subfolder
textProjectsDir=
